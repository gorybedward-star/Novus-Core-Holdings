# Server-side only. Set these in Vercel > Project > Settings > Environment Variables.
# Never prefix them with VITE_ (that would expose them to the browser).

# Option A (recommended): GoHighLevel Private Integration
GHL_PRIVATE_TOKEN=
GHL_LOCATION_ID=
# Optional: open an opportunity in your "New Lead" pipeline stage
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=

# Option B: GoHighLevel workflow Inbound Webhook URL (use instead of Option A)
GHL_WEBHOOK_URL=

# Option C (free, before GoHighLevel): Google Sheets + email via Apps Script. See docs/GOOGLE_SHEETS.md
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Optional: comma-separated list of origins allowed to post the form
ALLOWED_ORIGINS=https://novus-core-holdings.vercel.app

# Frontend (safe to expose). Only set if the form endpoint is not /api/lead.
# VITE_LEAD_ENDPOINT=
